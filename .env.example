# ── OpenSky Network (OAuth2 client credentials) ──────────────────────────────
# Create an API client at https://opensky-network.org/ (My OpenSky → API Clients)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ── Route providers ──────────────────────────────────────────────────────────
# adsbdb.com (free, keyless) is the primary source for flight routes.
ADSBDB_ENABLED=true
ADSBDB_BASE_URL=https://api.adsbdb.com/v0
ADSBDB_MAX_CONCURRENCY=2
ADSBDB_MIN_INTERVAL_MS=200

# ── FlightAware AeroAPI (optional route fallback) ────────────────────────────
# Only used for routes adsbdb doesn't have. Leave the key blank to disable.
FLIGHTAWARE_API_KEY=
FLIGHTAWARE_BASE_URL=https://aeroapi.flightaware.com/aeroapi
FLIGHTAWARE_MAX_CONCURRENCY=2
FLIGHTAWARE_MIN_INTERVAL_MS=350

# ── Hardware defaults (used when the device omits query params) ───────────────
HOME_LAT=40.7580
HOME_LON=-73.9965
DEFAULT_RADIUS_MILES=15

# ── Route cache (routes are static for a flight's life) ──────────────────────
ROUTE_CACHE_TTL_MS=43200000      # 12 hours for resolved routes
ROUTE_NEGATIVE_TTL_MS=10800000   # 3 hours for "no route found" (avoids re-query)
GC_INTERVAL_MS=1800000           # sweep + persist cache every 30 minutes
CACHE_PERSIST_PATH=data/route_cache.json

# ── Offline aircraft database (free mdl fallback) ────────────────────────────
# ICAO24 -> aircraft type lookup. Auto-downloaded on startup if missing/stale.
AIRCRAFT_DB_PATH=data/aircraftDatabase.csv
AIRCRAFT_DB_URL=https://opensky-network.org/datasets/metadata/aircraftDatabase.csv
AIRCRAFT_DB_AUTO_DOWNLOAD=true   # set false to skip auto-download entirely
AIRCRAFT_DB_MAX_AGE_DAYS=30      # re-download if older than this (0 = never)

# ── Filtering ────────────────────────────────────────────────────────────────
# Drop a plane outright if on_ground is true; if it isn't, rely on speed and
# keep the plane only when moving faster than the gate. Trusts on_ground when
# set and uses the speed gate when it isn't. Helicopters and all non-plane types
# are always kept.
FILTER_GROUNDED_PLANES=true
PLANE_MIN_SPEED_MPH=60

# ── Polling guidance (advertised to clients via X-Recommended-Poll-Seconds) ──
# OpenSky data refreshes every ~5s (the floor). The middleware backs the
# interval off automatically as OpenSky credits run low.
POLL_DEFAULT_SECONDS=30
POLL_MIN_SECONDS=5

# ── Marine / AIS (aisstream.io — free WebSocket; required for marine) ────────
# Get a free key at https://aisstream.io/. Leave blank to disable /api/marine.
AISSTREAM_API_KEY=
AISSTREAM_ENABLED=true
AISSTREAM_WS_URL=wss://stream.aisstream.io/v0/stream

# Marine channels: each /api/marine/{channel}/ holds its own WebSocket, kept
# alive for 8h after the last request to that channel, then closed to save
# monitoring. A later request re-opens it for another 8h.
MARINE_DEFAULT_RADIUS_MILES=15
MARINE_CHANNEL_IDLE_TTL_MS=28800000   # 8 hours from last request
MARINE_VESSEL_TTL_MS=900000           # drop a vessel after 15 min of silence
MARINE_GC_INTERVAL_MS=300000          # reap idle channels + sweep stores every 5 min

# Marine filtering (analog of the grounded/slow-plane filter): drop moored /
# anchored / aground vessels and those slower than the gate. Special-service
# vessels (SAR, law enforcement, pilot, military) are always kept.
FILTER_MOORED_VESSELS=true
MARINE_VESSEL_MIN_SPEED_KNOTS=0.5

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
